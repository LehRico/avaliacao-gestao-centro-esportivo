# Cada projeto (Backend/, Frontend/) mantém seu próprio .gitignore
# com as regras específicas de build, dependências e ambiente.

# OS
.DS_Store
Thumbs.db

# IDEs e editores
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# vscode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# AI tooling local caches (Claude Code, Windsurf, etc.)
/.agents
/.claude
/.windsurf
skills-lock.json
