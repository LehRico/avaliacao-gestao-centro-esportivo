{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "ES2023",
    "outDir": "./dist-seed",
    "rootDir": ".",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "resolveJsonModule": true
  },
  "include": ["prisma/seed.ts", "src/generated/**/*.ts"]
}
