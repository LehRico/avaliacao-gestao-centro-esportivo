# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/centro_esportivo?schema=public

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# --- Upload ---
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_DEST=./uploads

# --- External API (clima/feriados) ---
EXTERNAL_API_URL=https://api.exemplo.com
EXTERNAL_API_TIMEOUT_MS=5000
